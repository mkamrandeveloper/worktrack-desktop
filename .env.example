# ─── API Configuration ────────────────────────────────────────────────────────
# Main backend API base URL
API_BASE_URL=http://localhost:3000

# WebSocket server URL (defaults to API_BASE_URL if not set)
WS_URL=http://localhost:3000

# ─── Renderer (Vite) Environment Variables ────────────────────────────────────
# These must be prefixed with VITE_ to be exposed to the renderer process
VITE_API_BASE_URL=http://localhost:3000
VITE_APP_NAME=WorkTrack Desktop
VITE_APP_VERSION=1.0.0

# ─── Update Server ────────────────────────────────────────────────────────────
# GitHub release URL for electron-updater (leave blank to disable auto-updates)
UPDATE_FEED_URL=https://github.com/worktrack/worktrack-desktop/releases/latest

# ─── Security ─────────────────────────────────────────────────────────────────
# Encryption key for electron-store (32 char minimum for AES-256)
# In production this should be set per-machine or derived from hardware ID
STORAGE_ENCRYPTION_KEY=change-me-to-a-secure-random-32-char-key

# ─── Screenshot Settings ──────────────────────────────────────────────────────
# Default screenshot interval in minutes (overridden by organization settings)
DEFAULT_SCREENSHOT_INTERVAL_MINUTES=5

# Maximum image dimension before resizing (pixels)
SCREENSHOT_MAX_DIMENSION=1920

# JPEG quality (1-100)
SCREENSHOT_JPEG_QUALITY=75

# ─── Activity Monitoring ──────────────────────────────────────────────────────
# Idle threshold in seconds (default: 5 minutes)
IDLE_THRESHOLD_SECONDS=300

# Heartbeat interval in seconds
HEARTBEAT_INTERVAL_SECONDS=60

# ─── Development ──────────────────────────────────────────────────────────────
# Set to 'true' to open DevTools automatically in development
OPEN_DEVTOOLS=true

# Set to 'development' | 'staging' | 'production'
NODE_ENV=development
